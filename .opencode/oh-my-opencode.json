{
  // ============================================================
  // wx_game 项目专用 Oh My OpenCode 配置
  // 约束：生产级 Go/C++ 后端代码标准
  // ============================================================

  // 禁用不需要的 Hook（减少干扰）
  "disabled_hooks": [
    "comment-checker"  // 我们有自己的注释规范，不需要 AI 自动调整
  ],

  // Sisyphus 主编排智能体配置
  "agents": {
    "Sisyphus (Main)": {
      "enabled": true,
      "model": "anthropic/claude-opus-4-5",  // 使用最强模型确保质量
      "temperature": 0.1,  // 低温度，减少随机性，确保稳定输出
      "prompt_append": "\n\n## 项目特定约束\n\n你正在为一个**生产级微信小游戏后端**工作。工程师是资深专家级 Go/C++ 后端专家。\n\n**绝对约束：**\n1. 所有代码必须符合 `.opencode/AGENTS.md` 中定义的生产级标准\n2. 禁止任何技术债务、临时方案、hack 代码\n3. 性能、安全、可维护性是首要考虑因素\n4. 遇到架构决策时，必须先与用户讨论，不得擅自决定\n5. 所有并发代码必须有 context 控制和 race 检测\n6. 所有错误必须处理，禁止忽略任何 error 返回值\n7. 必须编写单元测试，核心逻辑测试覆盖率 >= 80%\n\n**代码风格：**\n- 简洁 > 复杂\n- 可读性 > 炫技\n- 健壮性 > 快速实现\n- 生产级 > 原型级\n\n**验证流程：**\n每次代码修改后必须执行：\n1. `go vet ./...`\n2. `golangci-lint run`（如果项目配置了）\n3. `go test -race ./...`\n4. `lsp_diagnostics` 检查类型错误\n5. 构建验证 `go build`\n\n记住：你的代码将在 **7x24 生产环境**运行，处理**真实用户的真实数据**。"
    },

    // Oracle：架构设计与深度调试顾问
    "Oracle (Advisor)": {
      "enabled": true,
      "model": "openai/gpt-5.2",  // 使用 GPT 5.2 的强推理能力
      "temperature": 0.05,  // 极低温度，确保严谨分析
      "prompt_append": "\n\n你是一个**资深架构师和性能专家**。\n\n在给出建议时：\n1. 必须分析多种方案的 trade-offs\n2. 必须考虑并发安全、内存泄漏、性能瓶颈\n3. 必须引用 Go 官方文档或业界最佳实践\n4. 必须指出潜在的坑（goroutine 泄漏、data race、死锁）\n5. 代码示例必须是生产级可用的\n\n你的建议将直接影响生产环境的稳定性。"
    },

    // 前端工程师（如果涉及 WebSocket 客户端测试等）
    "Frontend UI/UX Engineer": {
      "enabled": false  // 纯后端项目，禁用前端智能体
    },

    // Librarian：文档查询专家
    "Librarian (Researcher)": {
      "enabled": true,
      "prompt_append": "\n\n在查询 Go 相关文档时，优先查找：\n1. Go 官方文档和博客\n2. Uber Go Style Guide\n3. Dave Cheney 的性能优化指南\n4. OWASP Go 安全指南\n5. 高星级开源项目的实现（如 Kubernetes、Docker、etcd）"
    },

    // Prometheus 规划智能体
    "Prometheus (Planner)": {
      "enabled": true,
      "prompt_append": "\n\n在制定计划时，必须考虑：\n1. 单元测试计划（先写测试，后写实现）\n2. 性能基准测试计划（如涉及性能敏感代码）\n3. 并发安全验证计划（race 检测）\n4. 回滚方案（如果是重构）\n5. 监控和日志埋点计划"
    }
  },

  // 后台任务配置
  "background_task": {
    "enabled": true,
    "providerConcurrency": {
      "anthropic": 3,  // Claude 并发限制
      "openai": 5      // GPT 并发限制
    }
  },

  // 分类任务配置（domain-specific 模型选择）
  "categories": {
    "business-logic": {
      "model": "anthropic/claude-sonnet-4-5",
      "temperature": 0.1,
      "description": "核心业务逻辑实现（游戏逻辑、角色管理、排行榜）"
    },
    "ultrabrain": {
      "model": "openai/gpt-5.2",
      "temperature": 0.05,
      "description": "复杂算法、架构设计、性能优化"
    },
    "quick": {
      "model": "anthropic/claude-haiku-4",
      "temperature": 0.1,
      "description": "简单修改（配置调整、日志添加、注释更新）"
    }
  },

  // LSP 配置
  "lsp": {
    "enabled": true,
    "languages": ["go"],  // 仅启用 Go LSP
    "diagnosticLevel": "error"  // 只关注错误，警告由 golangci-lint 处理
  },

  // 实验性功能
  "experimental": {
    "aggressive_truncation": false,  // 禁用激进截断，保留完整错误信息
    "auto_resume_on_crash": true     // 如果智能体崩溃，自动恢复
  }
}
